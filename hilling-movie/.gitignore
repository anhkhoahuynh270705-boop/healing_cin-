.env
.env.*
!.env.example
!.env.*.example
.npmrc
!.npmrc.example
/src/environments/environment.local.ts
/src/environments/environment.*.local.ts
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secrets.json
*credentials*.json
*.token
id_rsa*
id_ed25519*

# Local data exports and diagnostic logs
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.sql.gz
*.log

